papers/http-session-noms-pt/article.pdf

# The authors' writing-style guide stays local
docs/writing-style.md

# LaTeX scratch
texput.log

# Private history, reviews and original handoffs remain local.
archive/local/

# Current PDFs and upload bundles are local build products.
submissions/*/article.pdf
submissions/*/*.zip

# Do not reintroduce complete manuscripts or upload projects in the current tree.
/papers/http-session-noms/*.tex
/papers/http-session-noms/*.pdf
/papers/http-session-noms/*.cls
/papers/http-session-noms/*.bst
/papers/http-session-noms/*.sty
